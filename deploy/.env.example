# Copy to deploy/.env and adjust. Never commit .env.

# LLM: any OpenAI-compatible endpoint; Ollama on the host by default.
# openai_compat | anthropic | fake (fake answers every question with a fixed text, for CI and UI work).
LLM_PROVIDER=openai_compat
# Ollama on the host. For the model inside compose: COMPOSE_PROFILES=ollama and http://ollama:11434/v1.
# For an external provider: its OpenAI-compatible URL, model and key.
LLM_BASE_URL=http://host.docker.internal:11434/v1
# COMPOSE_PROFILES=ollama
LLM_MODEL=qwen3.6:35b-a3b
LLM_API_KEY=ollama
# none | minimal | low | medium | high; empty keeps the model default. none turns Qwen thinking off:
# tool calls drop from ~8s to <1s locally.
LLM_REASONING_EFFORT=none
# Effort for answers in the detailed mode, where a few more seconds are fine; empty keeps LLM_REASONING_EFFORT.
LLM_REASONING_EFFORT_DETAILED=low
# 0..2; lower answers more alike between runs. Empty keeps the model default.
LLM_TEMPERATURE=0.3
# Several model sources: a JSON array; when set, LLM_BASE_URL, LLM_MODEL and LLM_API_KEY are ignored.
# Each endpoint serves max_concurrency turns at once, extra turns wait in a queue; a turn stays on one endpoint.
# reasoning_effort is optional and overrides LLM_REASONING_EFFORT for that endpoint.
# LLM_ENDPOINTS=[{"name":"pc","base_url":"http://host.docker.internal:11434/v1","api_key":"ollama","model":"qwen3.6:35b-a3b","max_concurrency":1},{"name":"uni","base_url":"https://llm.example.edu/v1","api_key":"token","model":"qwen3.6:35b-a3b","max_concurrency":4}]
# Turns the LLM_BASE_URL model serves at once; Ollama answers one request at a time by default.
LLM_MAX_CONCURRENCY=1
# How long a turn waits for a free model before it fails.
LLM_QUEUE_TIMEOUT=5m
# Limit of one turn, counted from getting a model.
TURN_TIMEOUT=80s
# Turns the worker runs at once, waiting ones included.
WORKER_CONCURRENCY=4

EMBEDDINGS_ENABLED=true
EMBEDDINGS_MODEL=bge-m3

# Infrastructure. Hosts are compose service names; use localhost when running buddy on the host.
POSTGRES_USER=buddy
POSTGRES_PASSWORD=buddy
POSTGRES_DB=buddy
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgres://buddy:buddy@postgres:5432/buddy?sslmode=disable
REDIS_ADDR=redis:6379
MOCKS_BASE_URL=http://mocks:8090

# At least 16 bytes; signs session tokens. Replace for any shared environment.
SESSION_SECRET=change-me-to-a-long-random-string
MOCK_FAIL_RATE=0
