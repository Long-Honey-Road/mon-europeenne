# Copy to deploy/.env and adjust. Never commit .env.

# LLM: any OpenAI-compatible endpoint; Ollama on the host by default.
# openai_compat | anthropic | fake (fake answers every question with a fixed text, for CI and UI work).
LLM_PROVIDER=openai_compat
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen3.6:35b-a3b
LLM_API_KEY=ollama
# none | minimal | low | medium | high; empty keeps the model default. none turns Qwen thinking off:
# tool calls drop from ~8s to <1s locally.
LLM_REASONING_EFFORT=none
# Effort for answers in the detailed mode, where a few more seconds are fine; empty keeps LLM_REASONING_EFFORT.
LLM_REASONING_EFFORT_DETAILED=low
# 0..2; lower answers more alike between runs. Empty keeps the model default.
LLM_TEMPERATURE=0.3

EMBEDDINGS_ENABLED=true
EMBEDDINGS_MODEL=bge-m3

# Infrastructure. Hosts are compose service names; use localhost when running buddy on the host.
POSTGRES_USER=buddy
POSTGRES_PASSWORD=buddy
POSTGRES_DB=buddy
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgres://buddy:buddy@postgres:5432/buddy?sslmode=disable
REDIS_ADDR=redis:6379
MOCKS_BASE_URL=http://mocks:8090

# At least 16 bytes; signs session tokens. Replace for any shared environment.
SESSION_SECRET=change-me-to-a-long-random-string
MOCK_FAIL_RATE=0
