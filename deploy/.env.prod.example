# Env file of a self-hosted stack; lives outside the repo, e.g. ~/srv/buddy-staging/.env, chmod 600.
# Never commit the filled copy: it holds the tunnel token and the database password.

# Separates containers, network and volumes from the dev stack ("buddy").
COMPOSE_PROJECT_NAME=buddy-staging

# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> the token from the install command.
TUNNEL_TOKEN=

# Generate both: openssl rand -hex 24
POSTGRES_PASSWORD=
SESSION_SECRET=
POSTGRES_USER=buddy
POSTGRES_DB=buddy

# Ollama on the host, same as dev.
LLM_PROVIDER=openai_compat
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen3.6:35b-a3b
LLM_API_KEY=ollama
LLM_REASONING_EFFORT=none
LLM_REASONING_EFFORT_DETAILED=low
LLM_TEMPERATURE=0.3

# Pull deploy (deploy/deploy.sh): which branch this stack follows and where it is reachable.
DEPLOY_BRANCH=develop
PUBLIC_URL=https://staging.honey-road.tech
REGISTRY=ghcr.io/long-honey-road
# Cloudflare Access service token for the smoke test (Zero Trust -> Access -> Service credentials).
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=